# Speech-to-text
ASSEMBLYAI_API_KEY=

# Expressive TTS + voice cloning
ELEVENLABS_API_KEY=

# Translation + register-detection LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Fallback TTS (used per ARCHITECTURE.md §5 if ElevenLabs fails/rate-limits)
FALLBACK_TTS_PROVIDER=openai
FALLBACK_TTS_API_KEY=

REGISTER_CONFIDENCE_THRESHOLD=0.5

# Only for `python -m app.benchmark --live` (an ElevenLabs voice ID to
# synthesize with). Leave empty otherwise.
BENCHMARK_VOICE_ID=
